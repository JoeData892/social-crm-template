# Copy to supabase/functions/.env (git-ignored), fill in, then:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Long random string; the iPhone Shortcuts send it as the x-crm-key header.
# Generate one with:  openssl rand -hex 32
CRM_SHARED_SECRET=
# Used only when a request doesn't include the phone's clock.
CRM_TIMEZONE=America/New_York

# Optional tuning
# CRM_MODEL=claude-opus-5-5
# CRM_INGEST_EFFORT=medium
# CRM_ASK_EFFORT=low
# CRM_REPLY_AFTER_MS=45000
